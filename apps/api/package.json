{
  "name": "@attendance/api",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build": "tsc --noEmit -p tsconfig.json",
    "start": "ts-node src/main.ts",
    "prisma:generate": "prisma generate",
    "test": "vitest run",
    "seed": "ts-node prisma/seed.ts",
    "setup": "prisma generate && prisma migrate dev --name v3_tasks_devices",
    "db:reset": "prisma migrate reset --force --skip-seed"
  },
  "dependencies": {
    "@attendance/shared": "*",
    "@nestjs/common": "^10.4.0",
    "@nestjs/core": "^10.4.0",
    "@nestjs/jwt": "^10.2.0",
    "@nestjs/platform-express": "^10.4.0",
    "@nestjs/schedule": "^4.1.2",
    "@prisma/client": "^5.22.0",
    "dotenv": "^18.0.5",
    "nodemailer": "^10.0.14",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.0.0",
    "@types/nodemailer": "^8.0.2",
    "prisma": "^5.22.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.5.0",
    "vitest": "^2.0.0"
  }
}