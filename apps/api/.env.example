DATABASE_URL=postgresql://postgres:YOUR_DB_PASSWORD@localhost:5432/attendance
JWT_SECRET=change-me-to-a-random-string-of-at-least-32-characters
NODE_ENV=development
PORT=3000

# Email (OTP codes). Create a Google "App password" for the sending account and paste it HERE ONLY (never in Git).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=your-sending-address@gmail.com
SMTP_PASS=your-16-character-app-password
SMTP_FROM_NAME=Bayt Al Mosawer

# Optional: if set, the first-run setup wizard asks for this key (extra protection while the server is public)
# SETUP_KEY=
