generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  SUPER_ADMIN
  COMPANY_ADMIN
  BRANCH_MANAGER
  HR
  EMPLOYEE
  PHOTOGRAPHER
  TEAM_LEAD
}

enum CheckInSource {
  GPS
  NETWORK
  FINGERPRINT
  MANUAL
  TASK
}

enum TaskStatus {
  SCHEDULED
  DONE
  CANCELLED
}

enum LeaveStatus {
  PENDING
  APPROVED
  REJECTED
}

model Company {
  id        String   @id @default(uuid())
  name      String
  slug      String   @unique // company code used at login
  timezone  String   @default("Asia/Riyadh")
  createdAt DateTime @default(now())
  branches  Branch[]
  users     User[]
  policies  AttendancePolicy[]
  biometricDevices BiometricDevice[]
  leaveTypes LeaveType[]
  holidays  Holiday[]
}

model Branch {
  id               String   @id @default(uuid())
  companyId        String
  company          Company  @relation(fields: [companyId], references: [id])
  name             String
  latitude         Decimal? @db.Decimal(9, 6)
  longitude        Decimal? @db.Decimal(9, 6)
  radiusMeters     Int?
  allowedIpRanges  String[] // CIDR list
  verificationModes CheckInSource[] // enabled modes per branch
  users            User[]
  biometricDevices BiometricDevice[]
  policyId         String?
  policy           AttendancePolicy? @relation(fields: [policyId], references: [id])
  @@index([companyId])
}

model User {
  id         String   @id @default(uuid())
  companyId  String
  company    Company  @relation(fields: [companyId], references: [id])
  branchId   String?
  branch     Branch?  @relation(fields: [branchId], references: [id])
  role       Role
  name       String
  email      String
  passwordHash String
  phone      String?
  emailVerifiedAt DateTime?
  mustChangePassword Boolean @default(false)
  tracksAttendance   Boolean @default(true)
  biometricId        String?   // user id enrolled on the fingerprint device
  failedLogins Int     @default(0)
  lockedUntil  DateTime?
  baseSalary Decimal  @default(0) @db.Decimal(12, 2)
  policyId   String?   // per-employee override (highest precedence)
  policy     AttendancePolicy? @relation(fields: [policyId], references: [id])
  active     Boolean  @default(true)
  devices    Device[]
  records    AttendanceRecord[]
  leaves     LeaveRequest[]
  otpChallenges OtpChallenge[]
  excuses    Excuse[]
  excuseRequests ExcuseRequest[]
  taskAssignments TaskAssignee[]
  refreshTokens RefreshToken[]
  summaries  MonthlySummary[]
  @@unique([companyId, email])
}

// Device binding: one active device per employee
model Device {
  id         String   @id @default(uuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id])
  deviceUid  String
  label      String?
  active     Boolean  @default(true)
  boundAt    DateTime @default(now())
  @@unique([userId, deviceUid])
}

model AttendanceRecord {
  id         String        @id @default(uuid())
  companyId  String
  userId     String
  user       User          @relation(fields: [userId], references: [id])
  localDate  String        // YYYY-MM-DD in company timezone
  checkInAt  DateTime      // SERVER time (authoritative)
  clientTime DateTime?     // anomaly flagging only
  source     CheckInSource
  status     String        // tier key from the policy (dynamic), e.g. GREEN/RED/BLACK
  ip         String?
  deviceUid  String?
  taskId     String?       // set when the check-in happened at a task location
  latitude   Decimal?      @db.Decimal(9, 6)
  longitude  Decimal?      @db.Decimal(9, 6)
  flags      String[]      // MOCK_LOCATION, CLOCK_SKEW, ...
  @@unique([userId, localDate]) // idempotent: one per day
  @@index([companyId, localDate])
}

model Holiday {
  id        String  @id @default(uuid())
  companyId String
  company   Company @relation(fields: [companyId], references: [id])
  date      String
  name      String
  @@unique([companyId, date])
}

model LeaveRequest {
  id        String      @id @default(uuid())
  companyId String
  userId    String
  user      User        @relation(fields: [userId], references: [id])
  fromDate  String
  toDate    String
  reason    String?
  status    LeaveStatus @default(PENDING)
  decidedById String?
  decidedAt   DateTime?
  createdAt   DateTime @default(now())
}

model MonthlySummary {
  id        String   @id @default(uuid())
  companyId String
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  year      Int
  month     Int
  policyId  String?
  policyConfig Json  // exact policy used (history stays correct after HR edits)
  snapshot  Json     // full engine output; recomputable from raw records
  computedAt DateTime @default(now())
  @@unique([userId, year, month])
}

model AuditLog {
  id        String   @id @default(uuid())
  companyId String
  actorId   String
  action    String
  entity    String
  entityId  String
  before    Json?
  after     Json?
  reason    String?
  at        DateTime @default(now())
  @@index([companyId, at])
}

// HR-managed, versioned. `config` = AttendancePolicy JSON from packages/shared (validated by validatePolicy()).
// Resolution order: User.policyId > Branch.policyId > the company policy with isDefault=true.
// Editing never mutates a row: create a new version (effectiveFrom) so past months stay reproducible.
model AttendancePolicy {
  id            String   @id @default(uuid())
  companyId     String
  company       Company  @relation(fields: [companyId], references: [id])
  name          String
  version       Int      @default(1)
  config        Json
  effectiveFrom String   // YYYY-MM-DD
  isDefault     Boolean  @default(false)
  active        Boolean  @default(true)
  createdById   String
  createdAt     DateTime @default(now())
  branches      Branch[]
  users         User[]
  @@index([companyId, isDefault])
}

model LeaveType {
  id        String  @id @default(uuid())
  companyId String
  company   Company @relation(fields: [companyId], references: [id])
  name      String
  paid      Boolean @default(true)
  requiresApproval Boolean @default(true)
  active    Boolean @default(true)
}

model OtpChallenge {
  id         String   @id @default(uuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id])
  deviceUid  String
  purpose    String   // FIRST_LOGIN | DEVICE_CHANGE
  codeHash   String
  expiresAt  DateTime
  attempts   Int      @default(0)
  consumedAt DateTime?
  createdAt  DateTime @default(now())
  @@index([userId, createdAt])
}

model RefreshToken {
  id         String   @id @default(uuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id])
  tokenHash  String   @unique
  deviceUid  String?
  expiresAt  DateTime
  revokedAt  DateTime?
  createdAt  DateTime @default(now())
  @@index([userId])
}

// HR-approved excuse for a RED/BLACK day (neutralizes it in the points engine). Reason is mandatory.
model Excuse {
  id          String   @id @default(uuid())
  companyId   String
  userId      String
  user        User     @relation(fields: [userId], references: [id])
  localDate   String
  reason      String
  createdById String
  createdAt   DateTime @default(now())
  @@unique([userId, localDate])
}

// An employee asks HR to excuse a late/absent day. Approval creates an Excuse.
model ExcuseRequest {
  id          String      @id @default(uuid())
  companyId   String
  userId      String
  user        User        @relation(fields: [userId], references: [id])
  localDate   String
  reason      String
  status      LeaveStatus @default(PENDING)
  decidedById String?
  decidedAt   DateTime?
  decisionNote String?
  createdAt   DateTime    @default(now())
  @@index([companyId, status])
  @@index([userId, localDate])
}

// Fingerprint / iris terminal (e.g. ZKTeco). A local agent will read it; this is its configuration.
model BiometricDevice {
  id           String    @id @default(uuid())
  companyId    String
  company      Company   @relation(fields: [companyId], references: [id])
  branchId     String
  branch       Branch    @relation(fields: [branchId], references: [id])
  name         String
  brand        String    @default("ZKTECO")
  model        String?
  host         String
  port         Int       @default(4370)
  serialNumber String?
  active       Boolean   @default(true)
  lastSeenAt   DateTime?
  lastSyncAt   DateTime?
  notes        String?
  apiKeyHash   String?   @unique // the agent authenticates with a per-device key (only its hash is stored)
  clockOffsetMs Int?     // device clock minus server clock, reported by the agent
  createdAt    DateTime  @default(now())
  punches      PunchLog[]
  @@index([companyId, branchId])
}

// A booking: a photographer (or several) is sent to a place at a time. Checking in at that place counts as attendance.
model Task {
  id           String       @id @default(uuid())
  companyId    String
  title        String
  details      String?
  latitude     Decimal      @db.Decimal(9, 6)
  longitude    Decimal      @db.Decimal(9, 6)
  radiusMeters Int          @default(150)
  address      String?
  startsAt     DateTime
  endsAt       DateTime
  status       TaskStatus   @default(SCHEDULED)
  createdById  String
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  assignees    TaskAssignee[]
  @@index([companyId, startsAt])
}

model TaskAssignee {
  id      String @id @default(uuid())
  taskId  String
  task    Task   @relation(fields: [taskId], references: [id], onDelete: Cascade)
  userId  String
  user    User   @relation(fields: [userId], references: [id])
  @@unique([taskId, userId])
  @@index([userId])
}

// One row per message we tried to send (email / whatsapp); the unique key makes reminders idempotent.
model NotificationLog {
  id        String   @id @default(uuid())
  companyId String
  userId    String
  kind      String   // ASSIGNED | UPDATED | CANCELLED | DAILY | REMINDER
  refKey    String   // task id, or the local date for the daily digest
  channel   String   // EMAIL | WHATSAPP
  status    String   // PENDING | SENT | FAILED
  error     String?
  createdAt DateTime @default(now())
  @@unique([userId, kind, refKey, channel])
  @@index([companyId, createdAt])
}

// WhatsApp Business (Meta Cloud API) settings, managed by the admin. The token is stored encrypted.
model WhatsappConfig {
  id               String   @id @default(uuid())
  companyId        String   @unique
  enabled          Boolean  @default(false)
  phoneNumberId    String?
  businessAccountId String?
  accessTokenEnc   String?
  templateDaily    String?
  templateReminder String?
  templateAssigned String?
  language         String   @default("ar")
  updatedAt        DateTime @updatedAt
}

// Every punch received from a fingerprint terminal, with what we did with it.
model PunchLog {
  id            String          @id @default(uuid())
  companyId     String
  deviceId      String
  device        BiometricDevice @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  biometricId   String
  punchedAtLocal String         // wall-clock "YYYY-MM-DDTHH:mm:ss" in the company timezone
  localDate     String
  userId        String?
  result        String          // RECORDED | IMPROVED | DUPLICATE_DAY | UNMAPPED | NOT_TRACKED | TOO_LATE | NO_POLICY
  status        String?
  createdAt     DateTime        @default(now())
  @@unique([deviceId, biometricId, punchedAtLocal])
  @@index([companyId, localDate])
}
