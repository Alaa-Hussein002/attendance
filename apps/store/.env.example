# Storefront database (SQLite by default; switch to Postgres for production)
DATABASE_URL="file:./dev.db"

# Public URL of this storefront (used for payment callbacks and emails)
NEXT_PUBLIC_BASE_URL=http://localhost:3002

# Admin panel password (change before going live)
ADMIN_PASSWORD=change-me
# Secret used to sign the admin session cookie
ADMIN_SESSION_SECRET=change-me-to-a-random-string

# Moyasar (Saudi payment gateway). Leave empty to use the mock payment simulator.
MOYASAR_SECRET_KEY=
PAYMENTS_MODE=mock

# Email (license delivery)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=your-sending-address@gmail.com
SMTP_PASS=your-16-character-app-password
SMTP_FROM_NAME=Bayt Al Mosawer

# Ed25519 PRIVATE key used to sign license keys. Generate once with:
#   npm run license:keygen -w @attendance/api
# Put the contents of license-keys/license-private.pem here (base64 or PEM).
LICENSE_PRIVATE_KEY=
LICENSE_PRIVATE_KEY_FILE=

NODE_ENV=development
