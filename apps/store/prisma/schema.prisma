generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Customer {
  id        String    @id @default(cuid())
  email     String    @unique
  name      String?
  company   String?
  phone     String?
  locale    String    @default("ar")
  createdAt DateTime  @default(now())
  orders    Order[]
  licenses  License[]
}

model Plan {
  id         String  @id @default(cuid())
  code       String  @unique
  nameAr     String
  nameEn     String
  priceSar   Int
  periodDays Int
  employees  Int
  branches   Int
  features   String
  active     Boolean @default(true)
  sortOrder  Int     @default(0)
  orders     Order[]
}

model Order {
  id          String    @id @default(cuid())
  number      String    @unique
  customerId  String
  customer    Customer  @relation(fields: [customerId], references: [id])
  planCode    String
  plan        Plan      @relation(fields: [planCode], references: [code])
  amount      Int
  currency    String    @default("SAR")
  status      String    @default("PENDING")
  provider    String?
  providerRef String?
  createdAt   DateTime  @default(now())
  paidAt      DateTime?
  license     License?
  meta        String?
}

model License {
  id             String    @id @default(cuid())
  serial         String    @unique
  key            String
  customerId     String
  customer       Customer  @relation(fields: [customerId], references: [id])
  orderId        String?   @unique
  order          Order?    @relation(fields: [orderId], references: [id])
  planCode       String
  email          String
  validUntil     String
  graceDays      Int       @default(14)
  limits         String
  features       String
  installationId String?
  revokedAt      DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
}

model Release {
  id        String   @id @default(cuid())
  version   String   @unique
  fileName  String
  sizeBytes Int      @default(0)
  sha256    String?
  notes     String?
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
}

model AdminSession {
  id        String   @id @default(cuid())
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
}


