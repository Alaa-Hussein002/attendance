# Bayt Al Mosawer — production environment for the VPS/Docker stack.
# Copy this file to deploy/.env and replace every CHANGE_ME value.
# Never commit deploy/.env.

# Public hostnames (DNS A records must point to the VPS IP)
WEB_DOMAIN=example.com
API_DOMAIN=api.example.com
PUBLIC_API_URL=https://api.example.com
CORS_ORIGINS=https://example.com

# Database
DB_PASSWORD=CHANGE_ME_LONG_RANDOM_PASSWORD

# API
JWT_SECRET=CHANGE_ME_AT_LEAST_64_RANDOM_CHARS
SETUP_KEY=CHANGE_ME_RANDOM_SETUP_KEY

# Email (OTP). Use an app password, never the mailbox password.
SMTP_HOST=smtp.example.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=no-reply@example.com
SMTP_PASS=CHANGE_ME_APP_PASSWORD
SMTP_FROM_NAME=شركة بيت المصور
